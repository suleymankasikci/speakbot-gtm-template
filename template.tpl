___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');
const queryPermission = require('queryPermission');

// The loader reads its key (and language) from its own address: GTM cannot set attributes on it.
let url = 'https://sponkly.com/speakbot/widget.js?key=' + encodeUriComponent(data.siteKey);
if (data.lang) url = url + '&lang=' + encodeUriComponent(data.lang);

if (queryPermission('inject_script', url)) {
  injectScript(url, data.gtmOnSuccess, data.gtmOnFailure, 'sponkly-speakbot');
} else {
  data.gtmOnFailure();
}


