___TESTS___

scenarios:
- name: Loads the SpeakBot loader with the site key
  code: |-
    const mockData = {siteKey: 'sb_abcdefghijklmnopqrstuvwx'};
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      assertThat(url).isEqualTo('https://sponkly.com/speakbot/widget.js?key=sb_abcdefghijklmnopqrstuvwx');
      assertThat(cacheToken).isEqualTo('sponkly-speakbot');
      onSuccess();
    });
    runCode(mockData);
    assertApi('gtmOnSuccess').wasCalled();
- name: Passes the widget language
  code: |-
    const mockData = {siteKey: 'sb_abcdefghijklmnopqrstuvwx', lang: 'de'};
    mock('injectScript', (url, onSuccess) => {
      assertThat(url).isEqualTo('https://sponkly.com/speakbot/widget.js?key=sb_abcdefghijklmnopqrstuvwx&lang=de');
      onSuccess();
    });
    runCode(mockData);
    assertApi('gtmOnSuccess').wasCalled();
- name: Reports a failed load
  code: |-
    const mockData = {siteKey: 'sb_abcdefghijklmnopqrstuvwx'};
    mock('injectScript', (url, onSuccess, onFailure) => {
      onFailure();
    });
    runCode(mockData);
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();


